{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "tests/worker.test.ts"
  ]
}
