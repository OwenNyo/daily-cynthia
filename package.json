{
  "name": "daily-cynthia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --exclude tests/worker.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test:worker": "wrangler d1 migrations apply DB --local && vitest run tests/worker.test.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@pkmn/client": "0.7.3",
    "@pkmn/data": "0.10.11",
    "@pkmn/protocol": "0.7.3",
    "@pkmn/randoms": "0.10.11",
    "@pkmn/sim": "0.10.11",
    "@pkmn/view": "0.7.3",
    "@smogon/calc": "0.12.0",
    "preact": "11.0.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
